{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowGraph",
  "version": "../package.json",
  "identifier": "dev.flowgraph.editor",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run web",
    "beforeDevCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowGraph",
        "width": 1480,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "FlowGraph",
        "width": 440,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Edytor diagramów przepływu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "yml",
          "yaml"
        ],
        "name": "Graf YAML",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Diagram Mermaid",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "macOS": {
      "dmg": {
        "background": "../dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 170,
          "y": 195
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 195
        },
        "windowPosition": {
          "x": 420,
          "y": 220
        }
      }
    }
  }
}
